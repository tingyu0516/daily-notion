# Notion internal integration token (https://www.notion.so/profile/integrations)
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Parent page where the two databases will be created.
# Open the page in Notion, copy the URL; the 32-char hex string at the end is the page id.
NOTION_PARENT_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Filled automatically by `python -m daily_notion.setup` -- do not edit by hand.
NOTION_TASKS_DB_ID=
NOTION_JOURNAL_DB_ID=
